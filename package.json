{
  "name": "boundless-checkout-react-cp",
  "version": "9.2.6",
  "description": "The official checkout React component for CC.",
  "keywords": [
    "cms",
    "headless",
    "ecommerce",
    "api",
    "checkout",
    "typescript",
    "cms",
    "cart",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephanieg467/boundless-checkout-react-cp.git"
  },
  "author": "Stephanie Galata <stephanieg467@hotmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "rm -rf ./dist && npx rollup --config rollup.prod.js --bundleConfigAsCjs",
    "verify": "tsc --noemit",
    "lint:styles": "stylelint ./styles",
    "lint:styles:fix": "stylelint ./styles --fix",
    "lint": "npm run lint:anti-slop && eslint ./src/",
    "lint:fix": "npm run lint:anti-slop -- --fix && eslint ./src/ --fix",
    "lint:anti-slop": "oxlint ./src/",
    "test": "vitest run",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:audit:ci": "fallow audit --base origin/master --gate new-only --ci --fail-on-issues --format json --quiet --explain",
    "fallow:audit:json": "fallow audit --format json --quiet",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health:baseline": "fallow health --score --hotspots --targets --save-baseline .github/fallow/baselines/health-baseline.json",
    "fallow:dead-code:baseline": "fallow dead-code --save-baseline .github/fallow/baselines/dead-code-baseline.json",
    "fallow:dupes:baseline": "fallow dupes --save-baseline .github/fallow/baselines/dupes-baseline.json",
    "fallow:fix:dry-run": "fallow fix --dry-run"
  },
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-react": "^7.22.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.1",
    "@oxlint/plugins": "1.87.0",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^11.1.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/react-query": "^5.66.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-redux": "^7.1.34",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fallow": "3.38.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "oxlint": "1.87.0",
    "postcss": "^8.4.28",
    "rollup": "^3.28.0",
    "rollup-plugin-import-css": "^3.3.1",
    "rollup-plugin-scss": "^4.0.0",
    "sass": "^1.49.0",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-order": "^8.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "last 3 chrome versions",
    "last 3 chromeandroid versions",
    "last 3 firefox versions",
    "last 3 opera versions",
    "last 2 edge versions",
    "safari >= 10",
    "ios >= 10"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.1.1",
    "@mui/x-date-pickers": "^8.11.0",
    "@reduxjs/toolkit": "^2.11.0",
    "@tanem/react-nprogress": "^5.0.55",
    "await-to-js": "^3.0.0",
    "clsx": "^1.1.1",
    "country-state-city": "^3.2.1",
    "currency.js": "^2.0.4",
    "dayjs": "^1.11.18",
    "formik": "^2.2.9",
    "i18next": "^23.4.4",
    "merrco-payfirma-simple-pay-module": "^1.0.1",
    "react-i18next": "^13.1.2",
    "react-imask": "^7.6.1",
    "react-redux": "^9.2.0",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tanstack/react-query": "^5.66.9",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
